# Copia este archivo como .env.local y sustituye los valores desde
# Supabase Dashboard > Connect. Nunca publiques la service_role key en Vite.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_publishable_key
VITE_ADMIN_APP_URL=https://admin.tu-dominio.com
VITE_CUSTOMER_APP_URL=https://app.tu-dominio.com

# El registro público está cerrado en fase 1. No usar VITE_SIGNUP_ACCESS_CODE
# ni VITE_ALLOW_PUBLIC_SIGNUP como autorización: Vite expone sus valores.
# Desactivar también "Allow new users to sign up" en Supabase Auth.

# Solo servidor: configurar en Vercel (Production), nunca con prefijo VITE_.
# Ver docs/notificaciones-push.md. Dejar sin configurar desactiva el botón push.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=clave_solo_servidor
# En Supabase Edge Functions, no en Vite:
# ALLOWED_ACTIVATION_ORIGINS=https://app.tu-dominio.com
# VAPID_PUBLIC_KEY=generar_con_npm_run_push_keys
# VAPID_PRIVATE_KEY=generar_con_npm_run_push_keys
# VAPID_SUBJECT=https://tu-dominio-de-produccion
# PUSH_CRON_SECRET=generar_con_npm_run_push_keys
